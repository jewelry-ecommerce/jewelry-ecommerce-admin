# Add these values in Vercel Project Settings > Environment Variables, then redeploy.
# Public build-time values only. No DB password or Cloudinary API secret belongs in FE.
VITE_DATA_SOURCE=HTTP
VITE_BACKEND_PROVIDER=JAVA
VITE_API_BASE_URL=https://YOUR-ACTUAL-SERVICE.onrender.com
VITE_API_PREFIX=/api/v1
