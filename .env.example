# Data source of the whole application. MOCK resolves every API call against the in-memory
# fixtures in `src/mocks`; HTTP sends the identical call to VITE_API_BASE_URL.
VITE_DATA_SOURCE=MOCK

# Artificial latency (ms) applied to mock resolvers so loading / disabled states are exercised.
VITE_MOCK_LATENCY_MS=180

# Root of the REST backend. Only read when VITE_DATA_SOURCE=HTTP.
VITE_API_BASE_URL=http://localhost:8082
VITE_API_PREFIX=/api/v1

# Dev server / preview port.
VITE_PORT=6100

# Shared local CMS mock is hosted by the client Next dev server.
VITE_CMS_DEMO_CLIENT_URL=http://127.0.0.1:3100

# No credentials belong in this file. The mock admin sign-in used by VITE_DATA_SOURCE=MOCK is
# documented in README.md and is demo-only fixture data — it is not a real secret and grants
# access to nothing outside the local in-memory fixtures.
